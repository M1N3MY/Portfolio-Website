<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=1140"> 
        <link rel="stylesheet" type="text/css" href="../home.css">
        <link rel="icon" type="image/png" href="images/favicon.png">
        <title>Sarah's Catalog</title>
    </head> 
    <style>
        body {
            background-color: #323c45 !important;
        }

        .text, .links, .content-header, .sidebar-header {
            color: #2e373c !important;
        }

        .content, .left-sidebar, .right-sidebar {
            border: 2px solid #eeefea !important; 
            background-color: #a2a9c1 !important; 
        }

        .links:hover {
            color: #191f22 !important;
        }

        .site-header, .top-nav-button {
            color: #cfd7e2 !important;
        }

        .top-nav-button:hover {
            color: #b4c0ce !important;
        }

        .wrapper {
            background-color: #4a5b75 !important;
        }

        .sidebar-border, .content-border {
            background-image: url("../images/snow.jpg") !important;
            border: 5px solid rgb(66, 72, 91) !important;
            background-size: cover;
            background-position: center;
        }

        .footer-text {
            color: #242c34;
        } 
    </style>
    <body> 
        <!--  
            GRID: a 3 row grid with a varying amount of columns 
                ROW 1: header
                ROW 2: wrapper
                ROW 3: area underneath wrapper
                ( this also includes empty margin space)

            ROW 1 (row-1): contains the site header, top nav buttons
                row 1 column 1 (r1c1): (open space)
                row 1 column 2 (r1c2): site name + top nav buttons        
                row 1 column 3 (r1c3): (open space)     
        -->
        <div class="grid">
            <div class="row-1">
                <!-- ROW 1 COLUMN 1 -->
                <div class="r1-c1">
                    <!-- ADD GIFS OR IMAGES HERE -->                    
                </div>  

                <!--  ROW 1 COLUMN 2 -->
                <div class="r1-c2">
                    <!-- HEADER: site name + top nav buttons -->
                    <header>
                        <h1 class="site-name">Sarah's Catalog</h1>
                        <!-- TOP NAV BUTTONS -->
                        <nav class="top-nav-btns">
                            <a href="../home.html" class="button top-nav-btn">Home</a>
                            <a href="projects.html" class="button top-nav-btn">Projects</a>
                            <a href="links.html" class="button top-nav-btn">Links</a>
                        </nav>   
                    </header>
                </div>  
                
                <!-- ROW 1 COLUMN 3 -->
                <div class="r1-c3">
                    <!-- ADD GIFS OR IMAGES HERE -->
                </div> 
            </div> <!-- END OF ROW 1 -->


            <!-- 
                ROW 2 (row-2): contains the wrapper
                    row 2 column 1 (r2c1): (open space)
                    row 2 column 2 (r2c2): wrapper + main container        
                    row 2 column 3 (r2c3): (open space)
            -->
            <div class="row-2">
                <!-- ROW 2 COLUMN 1 -->
                <div class="r2-c1">
                    <!-- ADD GIFS OR IMAGES HERE -->
                </div> 
                
                <!-- ROW 2 COLUMN 2-->
                <div class="r2-c2">
                    <!-- WRAPPER: wraps the main container -->
                    <div class="wrapper">  
                        <!-- MAIN CONTAINER: sidebars, main content (middle), footer --> 
                        <main>
                            <!-- LEFT SIDEBAR -->
                            <nav class="sidebar">
                                <div class="sidebar-border">
                                    <section class="left-sidebar">
                                        <a href="gallery.html" class="button side-nav-button"><img src="../images/gallery.png" width="43px" height="44px"></a>
                                        <a href="bedroom.html" class="button side-nav-button"><img src="../images/red-door.png"></a>
                                        <a href="door.html" class="button side-nav-button"><img src="../images/blue-door.png"></a>
                                    </section>
                                </div>
                            </nav>  <!-- END OF LEFT SIDEBAR -->

                            <!-- MIDDLE: main content -->
                            <div class="middle">
                                <!-- page info -->
                                <div class="content-border">
                                    <section class="content text p">
                                        <p> The following page includes links to any images and art I used. Plus some cool sites and resources.</p>
                                    </section>
                                </div>
                                
                                <!-- credits -->
                                <div class="content-border">
                                    <section class="content text p" style="gap:2px;">
                                        <h3 class="content-header">Images + GIFs</h3>
                                        <a class="links" href="https://textures.neocities.org/tex/pattern-and-prints/">splash page background</a>
                                        <a class="links" href="https://unsplash.com/photos/a-bunch-of-flowers-that-are-on-a-tree-TDXahvDHXLs">home sidebar + content border </a>
                                        <a class="links" href="https://cdn.esahubble.org/archives/images/thumb700x/heic0611b.jpg">project sidebar + content border</a>
                                        <a class="links" href="https://unsplash.com/photos/white-and-black-mountain-under-blue-and-white-sky-at-daytime-XgocbQbdO9s">links sidebar + content border</a>
                                        <a class="links" href="https://unsplash.com/photos/a-red-and-orange-wallpaper-with-a-floral-design-q0GUMkYUmds">gallery sidebar + content border</a>
                                        <a class="links" href="https://unsplash.com/photos/white-clouds-and-blue-sky-during-daytime--7EBIvSTG-k">bedroom sidebar + content border</a>
                                        <div class="blinkies">
                                            <a  href="https://momg.neocities.org/"><img alt="Visit the Gif Gallery!" src="https://momg.neocities.org/site-images/momg-badge.gif"></a>
                                            <a href="https://pixelsea.neocities.org/"><img src="../images/pixelsea-badge.gif"></a>
                                            <a href="https://textures.neocities.org/"><img src="../images/texturetown_badge.gif"></a>
                                        </div>
                                    </section>
                                </div>

                                <!-- super cool links -->
                                <div class="content-border">
                                    <section class="content text p">
                                        <h3 class="content-header">Cool Links</h3>
                                        <a class="links" href="https://github.com/M1N3MY/Portfolio-Website">website's github repo</a>
                                    </section>
                                </div>
                            </div> <!-- END OF MIDDLE -->

                            <!-- RIGHT SIDEBAR -->
                            <nav class="sidebar">
                                <div class="sidebar-border">
                                    <section class= "right-sidebar">
                                        <!-- ADD RIGHT SIDEBAR CONTENT HERE-->
                                    </section>
                                </div>
                            </nav> 
                        </main> <!-- END OF MAIN CONTAINER -->

                        <!-- FOOTER -->
                        <footer class="footer footer-text">
                            <p>Thanks for visiting!</p>
                            <img src="../images/cat-0491.gif" width="30" height="30"> 
                        </footer> <!-- END OF FOOTER--> 
                    </div> <!-- end of wrapper -->
                </div> <!-- (end of row 2 column 2)-->

                <!-- ROW 2 COLUMN 3 -->
                <div class="r2-c3">
                    <!-- ADD GIFS OR IMAGES HERE -->
                </div> 
            </div><!-- END OF ROW 2 -->


            <!-- 
                ROW 3: area underneath the wrapper  
            -->
            <div class="row-3">
                <!-- ADD GIFS OR IMAGES HERE -->
            </div> <!-- END OF ROW 3 -->
        </div> <!-- END OF GRID -->
    </body>
</html>